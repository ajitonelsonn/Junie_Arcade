generator client {
  provider = "prisma-client-js"
}

generator adminClient {
  provider = "prisma-client-js"
  output   = "../../admin_junie/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  REFLEX_ARENA
  JUMP_MASTER
  MEMORY_MATCH
  OVERALL
}

model Player {
  id        String   @id @default(cuid())
  username  String
  country   String?
  createdAt DateTime @default(now())
  scores    Score[]
}

model Score {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  gameType  GameType
  score     Int
  accuracy  Float?
  time      Float?
  maxCombo  Int?
  distance  Float?
  createdAt DateTime @default(now())

  @@index([gameType, score])
  @@index([createdAt])
}

model DailyLeaderboard {
  id        String   @id @default(cuid())
  date      DateTime @default(now()) @db.Date
  gameType  GameType
  topScores Json

  @@unique([date, gameType])
}

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @default("US")
  flag      String
  createdAt DateTime @default(now())

  @@index([name])
}

model GalleryItem {
  id        String   @id @default(cuid())
  url       String
  username  String
  score     Int
  gameType  GameType
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
